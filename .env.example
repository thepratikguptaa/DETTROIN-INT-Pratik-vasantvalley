# Copy to .env.local for local overrides. Nothing here is required to run the app.

# Point the client at a different API origin (default: same origin, proxied in dev)
# VITE_API_BASE=http://localhost:5000

# Express dev server port (must match the proxy target in vite.config.js)
# PORT=5000

# Allowed CORS origin for the dev API
# CORS_ORIGIN=http://localhost:5173

# Set to "false" to stop the dev API writing server/.data/enquiries.jsonl
# PERSIST_ENQUIRIES=true
